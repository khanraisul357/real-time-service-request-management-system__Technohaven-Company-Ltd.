# true  = run fully in the browser with the built-in mock backend (no server needed)
# false = talk to the Spring Boot backend (REST on /api, STOMP WebSocket on /ws)
VITE_USE_MOCK=false

# Optional overrides (defaults shown). In dev the Vite proxy forwards /api and /ws to http://localhost:8080
# VITE_API_BASE_URL=/api
# VITE_WS_URL=ws://localhost:8080/ws

# Display only: matches the backend ThreadPoolTaskExecutor size (design doc: 3)
VITE_WORKER_POOL_SIZE=3
